---
// A rendered finding card, built from RedScribe's real Finding model:
// severity, CVSS score, a classification tag, and workflow status. This
// is the hero's visual centerpiece instead of a stock dashboard mockup.
---

<div class="finding-card" role="img" aria-label="A RedScribe finding card, severity Critical, Broken Access Control, CVSS score 9.1, status QA Approved">
	<div class="finding-card__head">
		<span class="finding-card__id mono">F014</span>
		<span class="finding-card__severity">
			<span class="finding-card__dot" aria-hidden="true"></span>
			Critical
		</span>
	</div>
	<h3 class="finding-card__title">Broken Access Control on Invoice Export</h3>
	<dl class="finding-card__meta">
		<div>
			<dt>CVSS</dt>
			<dd class="mono">9.1</dd>
		</div>
		<div>
			<dt>Status</dt>
			<dd class="mono">Open</dd>
		</div>
		<div>
			<dt>Classification</dt>
			<dd>A01:2021&#8209;Broken&nbsp;Access&nbsp;Control</dd>
		</div>
	</dl>
	<div class="finding-card__foot">
		<span class="finding-card__stage">QA Approved</span>
		<span class="finding-card__stamp mono">Strictly Confidential</span>
	</div>
</div>

<style>
	.finding-card {
		width: min(22rem, 100%);
		background: var(--raised);
		border: 1px solid var(--hairline);
		border-radius: 10px;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.6);
	}

	.finding-card__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.finding-card__id {
		color: var(--ink-muted);
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
	}

	.finding-card__severity {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--alert);
	}

	.finding-card__dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--alert);
		box-shadow: 0 0 0 3px var(--alert-low);
	}

	.finding-card__title {
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 1.0625rem;
		color: var(--ink);
		letter-spacing: normal;
		line-height: 1.35;
	}

	.finding-card__meta {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		margin: 0;
		padding-top: 0.9rem;
		border-top: 1px solid var(--hairline-soft);
	}

	.finding-card__meta dt {
		font-size: 0.6875rem;
		color: var(--ink-muted);
		margin-bottom: 0.3rem;
	}

	.finding-card__meta dd {
		margin: 0;
		font-size: 0.8125rem;
		color: var(--ink-soft);
		line-height: 1.3;
	}

	.finding-card__foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 0.9rem;
		border-top: 1px solid var(--hairline-soft);
	}

	.finding-card__stage {
		font-size: 0.8125rem;
		color: var(--signal-high);
	}

	.finding-card__stamp {
		font-size: 0.6875rem;
		color: var(--ink-faint);
		letter-spacing: 0.03em;
	}
</style>
