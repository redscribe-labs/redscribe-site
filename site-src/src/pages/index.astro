---
import Header from '../components/Header.astro';
import FindingCard from '../components/FindingCard.astro';
import '../styles/global.css';

const capabilities = [
	{
		label: 'Engagements & findings',
		body: 'An engagement moves through a real status lifecycle with membership and scope-change approval. Findings carry CVSS v3.1 and v4.0 scoring, move through a draft, review, and QA workflow, and can be raised by hand, pulled from a shared vulnerability catalogue, or imported straight from Nmap, Burp Suite, or Nuclei output.',
	},
	{
		label: 'Reporting',
		body: 'One shared model drives every export, so Markdown, HTML, PDF, and Word all render the same report. Word export fills in a .docx template you design yourself, styled with your own document’s named styles, not a generic generated layout.',
	},
	{
		label: 'Client portal',
		body: 'Client accounts log in to a deliberately narrow view: their own released engagements, and within them, only findings that have actually cleared QA. Nothing else is editable, nothing else is visible.',
	},
	{
		label: 'Security',
		body: 'AES-256-GCM encryption per engagement, TOTP MFA required on every local account, and an append-only, hash-chained audit log covering every request, not only the ones that change something.',
	},
	{
		label: 'Administration',
		body: 'Roles and permissions are fully dynamic, not fixed tiers. Backup and restore runs encrypted and server-side, with an account-change diff shown before anything live gets overwritten.',
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/redscribe-site/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>RedScribe</title>
		<meta name="description" content="Self-hosted engagement, finding, checklist, and report management for penetration testing teams." />
	</head>
	<body>
		<Header />

		<main>
			<section class="hero">
				<div class="hero__text">
					<h1>Run the whole engagement,<br />not just the report.</h1>
					<p class="hero__sub">
						RedScribe is self-hosted engagement, finding, checklist, and
						report management for penetration testing teams who keep their
						own data on their own infrastructure.
					</p>
					<div class="hero__actions">
						<a class="btn btn--primary" href="https://redscribe-labs.github.io/redscribe-docs/getting-started/installation/">Read the docs</a>
						<a class="btn btn--ghost" href="https://github.com/redscribe-labs/redscribe">View source</a>
					</div>
					<p class="hero__note">Source-available. Free for personal and noncommercial use.</p>
				</div>
				<div class="hero__visual">
					<FindingCard />
				</div>
			</section>

			<section class="flow">
				<p class="flow__text">
					One engagement moves through one tool. Create it, run your
					checklist, log findings against it, review and QA them, then
					generate the report your client actually reads, in the format
					they asked for.
				</p>
			</section>

			<section class="capabilities" aria-label="Capabilities">
				<ul class="capabilities__list">
					{capabilities.map((item) => (
						<li class="capability">
							<h3 class="capability__label mono">{item.label}</h3>
							<p class="capability__body">{item.body}</p>
							{item.label === 'Security' && (
								<div class="chain" role="img" aria-label="A hash chain diagram: three audit log entries, each one's hash computed from its own fields chained onto the previous entry's hash">
									<div class="chain__node">
										<span class="chain__hash mono">a13f&hellip;9c02</span>
										<span class="chain__caption">entry #4,118</span>
									</div>
									<span class="chain__link" aria-hidden="true"></span>
									<div class="chain__node">
										<span class="chain__hash mono">6e21&hellip;7bd4</span>
										<span class="chain__caption">entry #4,119</span>
									</div>
									<span class="chain__link" aria-hidden="true"></span>
									<div class="chain__node chain__node--current">
										<span class="chain__hash mono">f048&hellip;1a3e</span>
										<span class="chain__caption">entry #4,120, current</span>
									</div>
								</div>
							)}
						</li>
					))}
				</ul>
			</section>

			<section class="license">
				<h2>One license, every feature.</h2>
				<p>
					RedScribe is source-available, not open source by the OSI&rsquo;s
					own definition. It&rsquo;s free for personal and community use
					under the PolyForm Noncommercial License. Running it at a
					for-profit consultancy needs a flat-fee commercial license, no
					per-seat pricing. Nothing about the feature set changes either
					way.
				</p>
				<a class="text-link" href="https://redscribe-labs.github.io/redscribe-docs/admin/licensing/">How licensing works</a>
			</section>

			<section class="install">
				<h2>Four ways to run it</h2>
				<p>
					Docker Compose with automated Tailscale HTTPS, your own TLS
					certificate, plain HTTP on a trusted network, or local
					development without Docker at all.
				</p>
				<pre class="install__snippet mono"><code>docker compose --profile tailscale up -d --build</code></pre>
				<a class="text-link" href="https://redscribe-labs.github.io/redscribe-docs/getting-started/installation/">Installation guide</a>
			</section>
		</main>

		<footer class="site-footer">
			<div class="site-footer__row">
				<a href="/redscribe-site/" class="wordmark">
					<svg viewBox="0 0 40 40" width="22" height="22" aria-hidden="true">
						<rect width="40" height="40" rx="9" fill="#111213"/>
						<rect x="9" y="11" width="22" height="4" rx="2" fill="#669966"/>
						<rect x="9" y="18" width="15" height="4" rx="2" fill="#7a8185"/>
						<rect x="9" y="25" width="9" height="4" rx="2" fill="#494d50"/>
					</svg>
					<span class="mono">RedScribe</span>
				</a>
				<nav aria-label="Footer">
					<a href="https://redscribe-labs.github.io/redscribe-docs/">Docs</a>
					<a href="https://github.com/redscribe-labs/redscribe">GitHub</a>
					<a href="https://redscribe-labs.github.io/redscribe-docs/admin/licensing/">License</a>
					<a href="https://github.com/redscribe-labs/redscribe/blob/main/.github/SECURITY.md">Security policy</a>
				</nav>
			</div>
			<p class="site-footer__meta mono">v0.1.0-alpha.1, early alpha, expect rough edges</p>
		</footer>

		<style>
			main {
				max-width: var(--content-width);
				margin: 0 auto;
				padding: 0 1.5rem;
			}

			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
				gap: 3rem;
				align-items: center;
				padding: 5.5rem 0 6rem;
			}

			.hero__text h1 {
				font-size: clamp(2.1rem, 4.2vw, 3.15rem);
				max-width: 18ch;
			}

			.hero__sub {
				margin-top: 1.6rem;
				font-size: 1.125rem;
				color: var(--ink-soft);
				max-width: 34rem;
			}

			.hero__actions {
				display: flex;
				gap: 0.9rem;
				margin-top: 2.2rem;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				font-family: var(--font-mono);
				font-size: 0.9375rem;
				padding: 0.7rem 1.3rem;
				border-radius: 6px;
				text-decoration: none;
				border: 1px solid transparent;
				transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
			}

			.btn--primary {
				background: var(--signal);
				color: #0e150e;
				font-weight: 600;
			}
			.btn--primary:hover {
				background: var(--signal-high);
			}

			.btn--ghost {
				border-color: var(--hairline);
				color: var(--ink-soft);
			}
			.btn--ghost:hover {
				border-color: var(--ink-muted);
				color: var(--ink);
			}

			.hero__note {
				margin-top: 1.4rem;
				font-size: 0.8125rem;
				color: var(--ink-muted);
			}

			.hero__visual {
				display: flex;
				justify-content: center;
			}

			.flow {
				border-top: 1px solid var(--hairline-soft);
				padding: 3rem 0;
			}

			.flow__text {
				max-width: 46rem;
				font-size: 1.1875rem;
				color: var(--ink);
				line-height: 1.55;
			}

			.capabilities {
				border-top: 1px solid var(--hairline-soft);
				padding: 4rem 0;
			}

			.capabilities__list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 2.4rem;
			}

			.capability {
				display: grid;
				grid-template-columns: 14rem minmax(0, 1fr);
				gap: 2rem;
				padding-bottom: 2.4rem;
				border-bottom: 1px solid var(--hairline-soft);
			}
			.capability:last-child {
				border-bottom: none;
				padding-bottom: 0;
			}

			.capability__label {
				font-size: 1.0625rem;
				color: var(--ink);
			}

			.capability__body {
				color: var(--ink-soft);
				max-width: 40rem;
			}

			.chain {
				grid-column: 2;
				margin-top: 1.5rem;
				display: flex;
				align-items: center;
				gap: 0;
				flex-wrap: wrap;
				max-width: 40rem;
			}

			.chain__node {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.4rem;
				padding: 0.8rem 1rem;
				border: 1px solid var(--hairline);
				border-radius: 8px;
				background: var(--raised);
			}
			.chain__node--current {
				border-color: var(--signal);
			}

			.chain__hash {
				font-size: 0.8125rem;
				color: var(--ink-soft);
			}
			.chain__node--current .chain__hash {
				color: var(--signal-high);
			}

			.chain__caption {
				font-size: 0.6875rem;
				color: var(--ink-muted);
			}

			.chain__link {
				width: 2.5rem;
				height: 1px;
				background: var(--hairline);
			}

			.license, .install {
				border-top: 1px solid var(--hairline-soft);
				padding: 4rem 0;
				max-width: 40rem;
			}

			.license h2, .install h2 {
				font-size: 1.5rem;
			}

			.license p, .install p {
				margin-top: 1.1rem;
				color: var(--ink-soft);
			}

			.text-link {
				display: inline-block;
				margin-top: 1.3rem;
				font-size: 0.9375rem;
				color: var(--signal-high);
				text-decoration: none;
				border-bottom: 1px solid var(--signal-low);
			}
			.text-link:hover {
				border-color: var(--signal-high);
			}

			.install__snippet {
				margin: 1.5rem 0 0;
				padding: 1rem 1.2rem;
				background: var(--raised);
				border: 1px solid var(--hairline);
				border-radius: 8px;
				font-size: 0.875rem;
				color: var(--signal-high);
				overflow-x: auto;
			}

			.site-footer {
				max-width: var(--content-width);
				margin: 2rem auto 0;
				padding: 2.5rem 1.5rem 3rem;
				border-top: 1px solid var(--hairline-soft);
			}

			.site-footer__row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1.5rem;
			}

			.site-footer .wordmark {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				text-decoration: none;
				color: var(--ink-soft);
				font-size: 0.9375rem;
			}
			.site-footer .wordmark svg {
				border-radius: 5px;
			}

			.site-footer nav {
				display: flex;
				gap: 1.5rem;
				flex-wrap: wrap;
			}
			.site-footer nav a {
				color: var(--ink-muted);
				text-decoration: none;
				font-size: 0.875rem;
			}
			.site-footer nav a:hover {
				color: var(--ink-soft);
			}

			.site-footer__meta {
				margin-top: 1.75rem;
				font-size: 0.75rem;
				color: var(--ink-faint);
			}

			@media (max-width: 56rem) {
				.hero {
					grid-template-columns: 1fr;
					padding-top: 3.5rem;
				}
				.hero__visual {
					justify-content: flex-start;
				}
				.capability {
					grid-template-columns: 1fr;
					gap: 0.6rem;
				}
				.chain {
					grid-column: 1;
				}
			}
		</style>
	</body>
</html>
