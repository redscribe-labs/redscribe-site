---
import Header from '../components/Header.astro';
import FindingCard from '../components/FindingCard.astro';
import Shot from '../components/Shot.astro';
import '../styles/global.css';

const DOCS = 'https://docs.redscribe.app';
const SAMPLE_PDF = `${DOCS}/sample-report.pdf`;

const proof = [
	'AES-256-GCM per engagement',
	'TOTP MFA on by default',
	'Hash-chained audit log',
	'PDF · HTML · Markdown · Word',
	'Self-hosted with Docker Compose',
];

const roles = [
	{
		who: 'For testers',
		title: 'Less time in Word.',
		body: 'Work the checklist, write findings with a built-in CVSS calculator, and pull in Nmap, Burp Suite, or Nuclei output. The report is generated from what you’ve already written.',
		shot: { name: 'crop-findings-dark', w: 840, h: 282, show: 840, alt: 'An engagement’s findings list with severity, status, workflow stage, and assigned reviewer and QA' },
	},
	{
		who: 'For reviewers and QA',
		title: 'A queue, not an inbox.',
		body: 'Everything assigned to you, in one list. Comment on the exact sentence, request changes, or approve. Nothing reaches the client until QA says so.',
		shot: { name: 'crop-queue-dark', w: 790, h: 329, show: 790, alt: 'My review queue: findings awaiting your review, with Draft and Changes Requested states' },
	},
	{
		who: 'For team leads',
		title: 'Every engagement at a glance.',
		body: 'Status across every engagement, who’s on each team, default reviewers and QA, scope-change approvals, and which drafts still have no reviewer.',
		shot: { name: 'crop-leads-dark', w: 518, h: 384, show: 0, fit: true, alt: 'Recent engagements on the dashboard with each engagement’s status: In Progress, Delivered, QA, Closed, Awaiting Remediation Test' },
	},
];

const steps = [
	{ n: '01', label: 'Create the engagement', href: '#engagements' },
	{ n: '02', label: 'Work the checklist', href: '#checklists' },
	{ n: '03', label: 'Write findings', href: '#findings' },
	{ n: '04', label: 'Review and QA', href: '#review' },
	{ n: '05', label: 'Deliver the report', href: '#reporting' },
];

const features = [
	{
		id: 'engagements',
		eyebrow: '01 · Engagements',
		title: 'Everything about the job, in one place.',
		body: 'Each client project is one engagement: its scope, dates, team, checklist progress, and every finding raised against it, moving through a real status lifecycle from In Progress to Delivered and on to remediation testing.',
		points: [
			'Status lifecycle from In Progress through QA, Delivered, and Closed',
			'Team membership with default reviewer and QA per engagement',
			'Scope changes go to a Team Lead for approval, with history kept',
		],
		link: { href: `${DOCS}/user-guide/engagements/`, label: 'How engagements work' },
		shot: { name: 'engagement-detail-dark', alt: 'An engagement overview in RedScribe: status, finding and checklist counts, scope, who has access, and review roles', path: 'redscribe.internal/engagements/RS-UMB-0369' },
	},
	{
		id: 'checklists',
		eyebrow: '02 · Checklists',
		title: 'Test methodically. See what’s left.',
		body: 'Run OWASP WSTG or your own template against an engagement, as many runs as the scope needs. Every item records what was tested and links to the findings it raised, and RedScribe nudges you toward the checks you haven’t touched yet.',
		points: [
			'OWASP WSTG, or your own templates in JSON or CSV',
			'Several independent runs per engagement',
			'Nmap, Burp Suite, and Nuclei import straight to Draft findings',
		],
		link: { href: `${DOCS}/user-guide/checklists/`, label: 'Checklists and scanner import' },
		shot: { name: 'checklist-run-dark', alt: 'An OWASP WSTG checklist run with overall progress, suggested next checks, and per-item status', path: 'redscribe.internal/engagements/RS-UMB-0369/checklist' },
	},
	{
		id: 'findings',
		eyebrow: '03 · Findings',
		title: 'Write it once. Score it properly.',
		body: 'Findings are rich-text write-ups built from the sections your firm defines, scored with a CVSS calculator that speaks both v3.1 and v4.0. Start from an approved vulnerability catalogue entry instead of a blank page.',
		points: [
			'Built-in CVSS v3.1 and v4.0 calculator',
			'Content sections you configure, per instance',
			'A shared, QA-approved vulnerability catalogue',
		],
		link: { href: `${DOCS}/user-guide/findings/`, label: 'Writing findings' },
		shot: { name: 'finding-editor-dark', alt: 'The finding editor with a rich-text description, severity and status, and the CVSS v4.0 calculator', path: 'redscribe.internal/findings/F001/edit' },
	},
	{
		id: 'review',
		eyebrow: '04 · Review and QA',
		title: 'Nothing reaches a client unchecked.',
		body: 'Every finding walks from Draft through Review to QA Approved, with named assignees at each step. Reviewers leave comments anchored to the exact text they’re about, so feedback lands where it applies.',
		points: [
			'Draft → Review → QA, with changes requested at either stage',
			'Inline comment threads anchored to highlighted text',
			'My Queue shows only what’s assigned to you',
		],
		link: { href: `${DOCS}/user-guide/findings/#the-review-workflow`, label: 'The review workflow' },
		shot: { name: 'finding-review-dark', alt: 'A finding in QA with an inline comment thread and the Review / QA panel showing each completed step', path: 'redscribe.internal/findings/F007' },
	},
];

const bento = [
	{ key: 'audit', title: 'Every request, hash-chained.', body: 'An append-only audit log covers every request, not just the ones that change something. Each entry’s hash chains onto the last, so tampering shows.' },
	{ key: 'cvss', title: 'CVSS v3.1 and v4.0.', body: 'Pick the metrics, get the vector and score. Or paste a vector you already have.' },
	{ key: 'crypto', title: 'Encrypted per engagement.', body: 'Sensitive fields are sealed with AES-256-GCM under each engagement’s own data key, wrapped by your instance’s root key.' },
	{ key: 'mfa', title: 'MFA from the first login.', body: 'By default, every local account enrols in TOTP before it can see anything. Require it per role, or sign in with Google or Microsoft.' },
	{ key: 'trends', title: 'Know how fast fixes land.', body: 'Mean time to remediate by severity, severity over time, and the classifications that keep recurring for the same client.' },
	{ key: 'roles', title: 'Roles are data, not tiers.', body: 'Build the roles your firm actually has, permission by permission. No fixed Admin/Editor/Viewer ladder.' },
	{ key: 'backup', title: 'Encrypted backup and restore.', body: 'Server-side, encrypted, and restore shows you an account-state diff before anything live is overwritten.' },
];

const footer = [
	{ title: 'Product', links: [
		{ href: '#features', label: 'Features' },
		{ href: '#reporting', label: 'Reporting' },
		{ href: '#security', label: 'Security' },
		{ href: SAMPLE_PDF, label: 'Sample report (PDF)' },
		{ href: `${DOCS}/changelog/`, label: 'Changelog' },
	] },
	{ title: 'Docs', links: [
		{ href: `${DOCS}/getting-started/quickstart/`, label: 'Quickstart' },
		{ href: `${DOCS}/getting-started/installation/`, label: 'Installation' },
		{ href: `${DOCS}/user-guide/dashboard/`, label: 'User guide' },
		{ href: `${DOCS}/security/encryption/`, label: 'Security model' },
	] },
	{ title: 'Project', links: [
		{ href: 'https://github.com/redscribe-labs/redscribe', label: 'GitHub' },
		{ href: `${DOCS}/admin/licensing/`, label: 'Licensing' },
		{ href: 'https://github.com/redscribe-labs/redscribe/blob/main/.github/SECURITY.md', label: 'Security policy' },
		{ href: `${DOCS}/dev/contributing/`, label: 'Contributing' },
	] },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>RedScribe · From first finding to final sign-off</title>
		<meta name="description" content="Self-hosted engagement, finding, checklist, and report management for penetration testing teams." />
		<meta name="theme-color" content="#111213" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://redscribe.app/" />
		<meta property="og:title" content="RedScribe · From first finding to final sign-off" />
		<meta property="og:description" content="Self-hosted engagement, finding, checklist, and report management for penetration testing teams." />
		<meta property="og:image" content="https://redscribe.app/screenshots/og-dashboard.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/plus-jakarta-sans-700.woff2" crossorigin />
		<script is:inline>document.documentElement.classList.add('js');</script>
		<!-- Cloudflare Web Analytics -->
		<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "d511489a748d406498644382d5352e40"}'></script>
		<!-- End Cloudflare Web Analytics -->
	</head>
	<body>
		<Header />

		<main>
			<!-- ============================================================ hero -->
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero__glow" aria-hidden="true"></div>
				<div class="wrap hero__inner">
					<a class="release" href={`${DOCS}/changelog/`}>
						<span class="release__tag mono">New</span>
						<span>RedScribe 0.2.0-alpha.3 is out</span>
						<span class="release__arrow" aria-hidden="true">→</span>
					</a>
					<h1 id="hero-title" class="hero__title">
						From first finding<br />
						<span class="grad-text">to final sign-off.</span>
					</h1>
					<p class="hero__sub">
						Testers work the checklist and write findings. Reviewers and QA sign
						them off. Team leads see every engagement, scope change, and queue at a
						glance. Then RedScribe builds the report. Self-hosted, and encrypted
						per engagement.
					</p>
					<div class="hero__actions">
						<a class="btn btn--primary" href={`${DOCS}/getting-started/quickstart/`}>Get started</a>
						<a class="btn btn--ghost" href={SAMPLE_PDF}>See a sample report</a>
					</div>
					<p class="hero__note">
						Free for personal and noncommercial use · Commercial use free for the first year · <a href={`${DOCS}/start/alpha-status/`}>Alpha software</a>
					</p>
				</div>

				<div class="wrap hero__stage">
					<Shot
						name="dashboard-dark"
						alt="The RedScribe dashboard: engagement counts, findings awaiting your review and QA, findings by severity and workflow status, and recently updated engagements"
						width={1920}
						height={1080}
						sizes="(min-width: 76rem) 73rem, 94vw"
						eager
						path="redscribe.internal"
					/>
					<div class="hero__float">
						<FindingCard />
					</div>
				</div>

				<div class="wrap">
					<ul class="proof" aria-label="Highlights">
						{proof.map((p) => (
							<li>
								<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M5 10.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
								{p}
							</li>
						))}
					</ul>
				</div>
			</section>

			<!-- ============================================================ roles -->
			<section class="roles wrap" aria-labelledby="roles-title">
				<div class="section-head section-head--center reveal">
					<span class="eyebrow">Built for the whole team</span>
					<h2 id="roles-title">One engagement. Everyone who touches it.</h2>
				</div>
				<div class="roles__grid">
					{roles.map((r) => (
						<article class="role reveal">
							<span class="role__who mono">{r.who}</span>
							<h3>{r.title}</h3>
							<p>{r.body}</p>
							<div class:list={['role__shot', { 'role__shot--fit': r.shot.fit }]} style={r.shot.fit ? undefined : `--show: ${r.shot.show}px`}>
								<Shot name={r.shot.name} alt={r.shot.alt} width={r.shot.w} height={r.shot.h} frame={false} single />
							</div>
						</article>
					))}
				</div>
			</section>

			<!-- ============================================================ flow -->
			<section class="flow wrap" id="features" aria-labelledby="flow-title">
				<div class="section-head reveal">
					<span class="eyebrow">One tool, start to finish</span>
					<h2 id="flow-title">The whole engagement, <br class="br-lg" />without switching tools.</h2>
				</div>
				<ol class="steps reveal">
					{steps.map((s) => (
						<li><a href={s.href}><span class="mono">{s.n}</span>{s.label}</a></li>
					))}
				</ol>
			</section>

			<!-- ============================================================ feature rows -->
			{features.map((f, i) => (
				<section class:list={['feature', 'wrap', { 'feature--flip': i % 2 === 1 }]} id={f.id} aria-labelledby={`${f.id}-title`}>
					<div class="feature__text reveal">
						<span class="eyebrow">{f.eyebrow}</span>
						<h2 id={`${f.id}-title`}>{f.title}</h2>
						<p>{f.body}</p>
						<ul class="ticks">
							{f.points.map((p) => <li>{p}</li>)}
						</ul>
						<a class="more" href={f.link.href}>{f.link.label} <span aria-hidden="true">→</span></a>
					</div>
					<div class="feature__media reveal">
						<div class="feature__halo" aria-hidden="true"></div>
						<Shot name={f.shot.name} alt={f.shot.alt} width={1920} height={1080} path={f.shot.path} />
					</div>
				</section>
			))}

			<!-- ============================================================ reporting (full-bleed) -->
			<section class="reporting" id="reporting" aria-labelledby="reporting-title">
				<div class="wrap">
					<div class="section-head section-head--center reveal">
						<span class="eyebrow">05 · Reporting</span>
						<h2 id="reporting-title">The report your client actually reads.</h2>
						<p>
							One shared model drives every export, so PDF, HTML, Markdown, and Word
							all render the same report. Word export fills in a .docx template you
							design yourself, styled with your own document’s named styles.
						</p>
					</div>
					<div class="reporting__pages reveal">
						<Shot name="sample-report-pages" alt="Three pages of an exported RedScribe PDF report: the cover, a findings-by-severity chart with an overview table, and a finding write-up" width={1920} height={880} frame={false} sizes="(min-width: 76rem) 68rem, 94vw" />
					</div>
					<ul class="formats reveal" aria-label="Export formats">
						<li><strong>PDF</strong><span>with optional password</span></li>
						<li><strong>Word</strong><span>your own .docx template</span></li>
						<li><strong>HTML</strong><span>self-contained file</span></li>
						<li><strong>Markdown</strong><span>zipped export</span></li>
					</ul>
					<div class="center reveal">
						<a class="btn btn--primary" href={SAMPLE_PDF}>Download the 38-page sample</a>
						<a class="btn btn--ghost" href={`${DOCS}/admin/report-profiles/`}>Report profiles</a>
					</div>
				</div>
			</section>

			<!-- ============================================================ client portal -->
			<section class="feature wrap" id="portal" aria-labelledby="portal-title">
				<div class="feature__text reveal">
					<span class="eyebrow">06 · Client portal</span>
					<h2 id="portal-title">A narrow, read-only door for clients.</h2>
					<p>
						Client accounts see their own released engagements and, within them,
						only findings that have actually cleared QA. Nothing is editable, and
						nothing else is visible.
					</p>
					<ul class="ticks">
						<li>Release an engagement to the client when it’s ready</li>
						<li>Only QA-approved findings, ever</li>
						<li>See which findings each client user has opened</li>
					</ul>
					<a class="more" href={`${DOCS}/client-portal/for-clients/`}>What clients see <span aria-hidden="true">→</span></a>
				</div>
				<div class="feature__media reveal">
					<div class="feature__halo feature__halo--navy" aria-hidden="true"></div>
					<Shot name="client-portal-dark" alt="The RedScribe client portal: a released engagement with severity counts and its QA-approved findings" width={1920} height={1080} path="redscribe.internal/portal" />
				</div>
			</section>

			<!-- ============================================================ bento -->
			<section class="security wrap" id="security" aria-labelledby="security-title">
				<div class="section-head reveal">
					<span class="eyebrow">Security and administration</span>
					<h2 id="security-title">Built for work that can’t cut corners.</h2>
					<p>
						A pentest firm’s findings are sensitive by nature, and some clients raise
						the bar further. These defaults were chosen with that in mind from the start.
					</p>
				</div>

				<div class="bento">
					{bento.map((b) => (
						<article class:list={['tile', `tile--${b.key}`, 'reveal']}>
							<h3>{b.title}</h3>
							<p>{b.body}</p>

							{b.key === 'audit' && (
								<div class="tile__media">
									<div class="chain" role="img" aria-label="Three audit log entries, each hash computed from its own fields chained onto the previous entry's hash">
										<div class="chain__node"><span class="mono">a13f…9c02</span><small>#4,118</small></div>
										<span class="chain__link" aria-hidden="true"></span>
										<div class="chain__node"><span class="mono">6e21…7bd4</span><small>#4,119</small></div>
										<span class="chain__link" aria-hidden="true"></span>
										<div class="chain__node chain__node--current"><span class="mono">f048…1a3e</span><small>current</small></div>
									</div>
									<Shot name="audit-log-dark" alt="The RedScribe audit log filtered to state-changing requests" width={1920} height={1080} frame={false} class="tile__peek" sizes="(min-width: 76rem) 48rem, 92vw" />
								</div>
							)}
							{b.key === 'cvss' && (
								<Shot name="crop-cvss-dark" alt="The CVSS v4.0 calculator with metric pickers" width={399} height={660} frame={false} single class="tile__crop" />
							)}
							{b.key === 'crypto' && (
								<div class="keys mono" aria-hidden="true">
									<span class="keys__row"><em>root key</em><b></b></span>
									<span class="keys__row keys__row--sub"><em>RS-UMB-0369</em><b></b></span>
									<span class="keys__row keys__row--sub"><em>RS-INI-0412</em><b></b></span>
									<span class="keys__row keys__row--sub"><em>RS-CYB-0388</em><b></b></span>
								</div>
							)}
							{b.key === 'mfa' && (
								<div class="otp mono" aria-hidden="true"><span>482</span><span>913</span></div>
							)}
							{b.key === 'trends' && (
								<Shot name="crop-mttr-dark" alt="Mean time to remediate: 25.1 days on average, broken down by severity" width={788} height={296} frame={false} single class="tile__crop" />
							)}
						</article>
					))}
				</div>

				<dl class="facts reveal">
					<div><dt>Encryption</dt><dd class="mono">AES-256-GCM, per engagement</dd></div>
					<div><dt>Audit trail</dt><dd class="mono">Hash-chained, every request</dd></div>
					<div><dt>MFA</dt><dd class="mono">Required by default</dd></div>
					<div><dt>Audit retention</dt><dd class="mono">6-year default</dd></div>
				</dl>
				<p class="disclaimer reveal">
					None of this makes RedScribe “compliant” by itself; that’s always down to whoever
					operates it. It means the technical foundation doesn’t fight you when you need one.
				</p>
			</section>

			<!-- ============================================================ license -->
			<section class="license wrap" id="license" aria-labelledby="license-title">
				<div class="license__card reveal">
					<div class="license__intro">
						<span class="eyebrow">Pricing</span>
						<h2 id="license-title">Commercial use is free right now.</h2>
						<p>
							Every feature ships on every instance, with no exceptions. As a kickstart
							for the community, a commercial license key costs nothing for the first
							year. Priced tiers arrive once RedScribe has been proven at the scale real
							enterprise engagements demand.
						</p>
						<div class="license__actions">
							<a class="btn btn--primary" href="mailto:redscribe.maintainer@proton.me?subject=RedScribe%20commercial%20license%20key">Request a free key</a>
							<a class="btn btn--ghost" href={`${DOCS}/admin/licensing/`}>How licensing works</a>
						</div>
					</div>
					<div class="plans">
						<div class="plan">
							<h3>Personal and noncommercial</h3>
							<p class="plan__price">Free<span>, forever</span></p>
							<p>Under the PolyForm Noncommercial License 1.0.0.</p>
						</div>
						<div class="plan plan--hl">
							<h3>Commercial</h3>
							<p class="plan__price">Free<span>, first year</span></p>
							<p>Including for-profit consultancies. Email for a key.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- ============================================================ install -->
			<section class="install wrap" id="install" aria-labelledby="install-title">
				<div class="install__text reveal">
					<span class="eyebrow">Install</span>
					<h2 id="install-title">Up and running on your own box.</h2>
					<p>
						Four supported ways to run it: Docker Compose with automated Tailscale
						HTTPS, your own TLS certificate, plain HTTP on a trusted network, or local
						development without Docker.
					</p>
					<a class="more" href={`${DOCS}/getting-started/installation/`}>Installation guide <span aria-hidden="true">→</span></a>
				</div>
				<div class="terminal reveal" role="region" aria-label="Quickstart commands">
					<div class="terminal__bar" aria-hidden="true"><i></i><i></i><i></i><span class="mono">quickstart</span></div>
					<pre class="mono"><code><span class="c"># Local try-out: no TLS, no domain</span>
<span class="p">$</span> git clone https://github.com/redscribe-labs/redscribe && cd redscribe
<span class="p">$</span> cp .env.example .env   <span class="c"># plus three secret files, see the quickstart</span>
<span class="p">$</span> docker compose up -d --build
<span class="p">$</span> docker compose exec web python manage.py generate_root_key
<span class="c"># paste the printed key into secrets/root_key.txt, then:</span>
<span class="p">$</span> docker compose up -d web
<span class="c"># open http://localhost:8000/setup/</span></code></pre>
				</div>
			</section>

			<!-- ============================================================ closing CTA -->
			<section class="closing" aria-labelledby="closing-title">
				<div class="closing__glow" aria-hidden="true"></div>
				<div class="wrap closing__inner reveal">
					<h2 id="closing-title">Your findings. Your infrastructure.<br /><span class="grad-text">Your report.</span></h2>
					<p>Spin up RedScribe in minutes and run your next engagement end to end.</p>
					<div class="hero__actions">
						<a class="btn btn--primary" href={`${DOCS}/getting-started/quickstart/`}>Get started</a>
						<a class="btn btn--ghost" href="https://github.com/redscribe-labs/redscribe">View on GitHub</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap site-footer__grid">
				<div class="site-footer__brand">
					<a href="/" class="wordmark" aria-label="RedScribe home">
						<svg viewBox="0 0 40 40" width="24" height="24" aria-hidden="true">
							<rect width="40" height="40" rx="9" fill="#181a1b"/>
							<rect x="9" y="11" width="22" height="4" rx="2" fill="#669966"/>
							<rect x="9" y="18" width="15" height="4" rx="2" fill="#7a8185"/>
							<rect x="9" y="25" width="9" height="4" rx="2" fill="#494d50"/>
						</svg>
						<span class="mono">RedScribe</span>
					</a>
					<p>Self-hosted engagement, finding, checklist, and report management for penetration testing teams.</p>
